# =============================================================================
# FoodBridge environment variables
# =============================================================================
# SECURITY BOUNDARY — read before editing:
#   * Anything prefixed with VITE_ is embedded into the browser bundle by Vite
#     and is therefore PUBLIC. Only publishable / anon keys may use that prefix.
#   * Everything WITHOUT the VITE_ prefix stays server-side only (Node/Express
#     in server.ts). Secrets (service-role key, Gemini key) MUST stay here and
#     MUST NEVER be given a VITE_ prefix or referenced from React/Vite code.
# =============================================================================


# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY (secrets — never exposed to the browser)
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: Required for Gemini AI API calls. Used only by the Express
# backend (server.ts). Never referenced from frontend code.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=https://food-bridge-blush.vercel.app/

# Supabase — SERVER-SIDE credentials for privileged operations (user
# registration via POST /api/users in server.ts). The service-role key bypasses
# Row Level Security and is a SECRET: keep it backend-only, never prefix with
# VITE_, never import it into a React component.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""


# ---------------------------------------------------------------------------
# BROWSER-SIDE (public / publishable — safe to ship in the client bundle)
# ---------------------------------------------------------------------------

# Supabase Auth for the browser (progressive enhancement). These are the PUBLIC
# project URL and the anon/publishable key — the same values Supabase prints
# under "Project Settings > API > Project URL / anon public". They are designed
# to be exposed to clients and are protected by Row Level Security.
#
# If BOTH are set, the Login modal offers a secure email + password sign-in
# (src/lib/supabaseClient.ts). If EITHER is blank, the app transparently falls
# back to the existing local / demo login — nothing breaks.
#
# NEVER put the service-role key here. Only the anon/publishable key belongs on
# a VITE_-prefixed variable.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
